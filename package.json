{
  "name": "browzenta",
  "version": "0.1.0",
  "description": "Deterministic browser automation and inspection CLI tool for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "browzenta": "./bin/browzenta.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build && npm run typecheck",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansxcode/browzenta.git"
  },
  "bugs": {
    "url": "https://github.com/ansxcode/browzenta/issues"
  },
  "homepage": "https://github.com/ansxcode/browzenta#readme",
  "keywords": [
    "browser",
    "automation",
    "screenshot",
    "playwright",
    "ai-agent",
    "cli",
    "testing",
    "inspection"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
